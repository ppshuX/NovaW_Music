<!--pages/posts/post-list/post-list.wxml-->
<view class="container columns-container">
  <!-- 总标题 -->
  <view class="app-header">
    <view class="app-title">NovaW_Music</view>
    <view class="app-subtitle">音乐成长记录</view>
  </view>

  <!-- 三栏布局 -->
  <view class="posts-columns">
    <!-- 练习中 -->
    <view class="post-column">
      <view class="column-header">
        <view class="column-title">
          <text class="column-icon">🎵</text>
          <text class="column-name">练习中</text>
        </view>
        <text class="column-count">{{practicingPosts.length}}</text>
      </view>
      <view class="column-content">
        <view 
          class="post-card-compact post-card-{{item.type}}" 
          wx:for="{{practicingPosts}}" 
          wx:key="post_id"
        >
          <view class="post-compact-header">
            <view class="post-type-badge-compact post-type-{{item.type}}">
              {{item.type === 'song_coming' ? '预告' : '发布'}}
            </view>
            <text class="post-time-compact">{{formatDate(item.created_at, 'MM-DD')}}</text>
          </view>
          <view class="post-compact-image" wx:if="{{item.images && item.images.length > 0}}">
            <image 
              class="compact-image" 
              src="{{item.images[0]}}" 
              mode="aspectFill"
              bindtap="previewImage"
              data-url="{{item.images[0]}}"
              data-urls="{{item.images}}"
            ></image>
          </view>
          <view class="post-compact-title">{{item.title}}</view>
          <view class="post-compact-content" wx:if="{{item.content}}">{{item.content}}</view>
          <view class="post-compact-song" wx:if="{{item.song_title}}">
            <text class="song-icon">🎵</text>
            <text class="song-name-compact">{{item.song_title}}</text>
          </view>
          <view class="post-compact-actions" wx:if="{{!readonly}}">
            <text class="action-icon-compact" bindtap="editPost" data-post-id="{{item.post_id}}">✏️</text>
            <text class="action-icon-compact delete" bindtap="deletePost" data-post-id="{{item.post_id}}">🗑️</text>
          </view>
        </view>
        <view class="empty-column" wx:if="{{practicingPosts.length === 0}}">
          <text class="empty-text-compact">暂无</text>
        </view>
      </view>
    </view>

    <!-- 小演出 -->
    <view class="post-column">
      <view class="column-header">
        <view class="column-title">
          <text class="column-icon">🎤</text>
          <text class="column-name">小演出</text>
        </view>
        <text class="column-count">{{showPosts.length}}</text>
      </view>
      <view class="column-content">
        <view 
          class="post-card-compact post-card-show" 
          wx:for="{{showPosts}}" 
          wx:key="post_id"
        >
          <view class="post-compact-header">
            <view class="post-type-badge-compact post-type-show">演出</view>
            <text class="post-time-compact">{{formatDate(item.created_at, 'MM-DD')}}</text>
          </view>
          <view class="post-compact-image" wx:if="{{item.images && item.images.length > 0}}">
            <image 
              class="compact-image" 
              src="{{item.images[0]}}" 
              mode="aspectFill"
              bindtap="previewImage"
              data-url="{{item.images[0]}}"
              data-urls="{{item.images}}"
            ></image>
          </view>
          <view class="post-compact-title">{{item.title}}</view>
          <view class="post-compact-content" wx:if="{{item.content}}">{{item.content}}</view>
          <view class="post-compact-info" wx:if="{{item.date || item.location}}">
            <text class="info-text-compact" wx:if="{{item.date}}">📅 {{formatPostDate(item.date)}}</text>
            <text class="info-text-compact" wx:if="{{item.location}}">📍 {{item.location}}</text>
          </view>
          <view class="post-compact-actions" wx:if="{{!readonly}}">
            <text class="action-icon-compact" bindtap="editPost" data-post-id="{{item.post_id}}">✏️</text>
            <text class="action-icon-compact delete" bindtap="deletePost" data-post-id="{{item.post_id}}">🗑️</text>
          </view>
        </view>
        <view class="empty-column" wx:if="{{showPosts.length === 0}}">
          <text class="empty-text-compact">暂无</text>
        </view>
      </view>
    </view>

    <!-- 计划中 -->
    <view class="post-column">
      <view class="column-header">
        <view class="column-title">
          <text class="column-icon">📅</text>
          <text class="column-name">计划中</text>
        </view>
        <text class="column-count">{{plannedPosts.length}}</text>
      </view>
      <view class="column-content">
        <view 
          class="post-card-compact post-card-{{item.type}}" 
          wx:for="{{plannedPosts}}" 
          wx:key="post_id"
        >
          <view class="post-compact-header">
            <view class="post-type-badge-compact post-type-{{item.type}}">
              {{item.type === 'song_coming' ? '预告' : item.type === 'song_released' ? '发布' : '演出'}}
            </view>
            <text class="post-time-compact">{{formatDate(item.created_at, 'MM-DD')}}</text>
          </view>
          <view class="post-compact-image" wx:if="{{item.images && item.images.length > 0}}">
            <image 
              class="compact-image" 
              src="{{item.images[0]}}" 
              mode="aspectFill"
              bindtap="previewImage"
              data-url="{{item.images[0]}}"
              data-urls="{{item.images}}"
            ></image>
          </view>
          <view class="post-compact-title">{{item.title}}</view>
          <view class="post-compact-content" wx:if="{{item.content}}">{{item.content}}</view>
          <view class="post-compact-date" wx:if="{{item.date}}">
            <text class="date-label">计划日期：</text>
            <text class="date-value">{{formatPostDate(item.date)}}</text>
          </view>
          <view class="post-compact-song" wx:if="{{item.song_title}}">
            <text class="song-icon">🎵</text>
            <text class="song-name-compact">{{item.song_title}}</text>
          </view>
          <view class="post-compact-actions" wx:if="{{!readonly}}">
            <text class="action-icon-compact" bindtap="editPost" data-post-id="{{item.post_id}}">✏️</text>
            <text class="action-icon-compact delete" bindtap="deletePost" data-post-id="{{item.post_id}}">🗑️</text>
          </view>
        </view>
        <view class="empty-column" wx:if="{{plannedPosts.length === 0}}">
          <text class="empty-text-compact">暂无</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 发布按钮（仅主人可见） -->
  <view class="fab fab-showcase" bindtap="createPost" wx:if="{{!readonly}}">
    <text class="fab-icon">✏️</text>
  </view>
</view>

