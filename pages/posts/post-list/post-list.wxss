/* pages/posts/post-list/post-list.wxss */
.timeline-container {
  background: linear-gradient(180deg, #16213e 0%, #1a1a2e 100%);
  min-height: 100vh;
}

.app-header {
  padding: 50rpx 30rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(15, 52, 96, 0.3) 0%, rgba(83, 52, 131, 0.2) 100%);
  margin-bottom: 30rpx;
  border-bottom: 1px solid rgba(15, 52, 96, 0.3);
}

.app-title {
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.app-subtitle {
  font-size: 26rpx;
  color: rgba(234, 234, 234, 0.7);
}

.timeline {
  position: relative;
  padding: 40rpx 0 200rpx 80rpx;
}

.timeline-item {
  position: relative;
  margin-bottom: 50rpx;
}

.timeline-dot {
  position: absolute;
  left: -60rpx;
  top: 30rpx;
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  border-radius: 50%;
  border: 4rpx solid #16213e;
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: -50rpx;
  top: 50rpx;
  width: 2rpx;
  height: calc(100% + 20rpx);
  background: linear-gradient(180deg, #0f3460 0%, transparent 100%);
  z-index: 1;
}

/* 三栏布局 */
.posts-columns {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx 150rpx;
  align-items: flex-start;
}

.post-column {
  flex: 1;
  min-width: 0;
}

.column-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 15rpx;
  margin-bottom: 15rpx;
  background: linear-gradient(135deg, rgba(15, 52, 96, 0.3) 0%, rgba(83, 52, 131, 0.2) 100%);
  border-radius: 12rpx;
  border: 1px solid rgba(15, 52, 96, 0.3);
}

.column-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.column-icon {
  font-size: 32rpx;
}

.column-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #eaeaea;
}

.column-count {
  font-size: 24rpx;
  color: #8b8b8b;
  background-color: rgba(15, 52, 96, 0.5);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.column-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  max-height: calc(100vh - 300rpx);
  overflow-y: auto;
}

/* 紧凑卡片样式 */
.post-card-compact {
  background-color: #1a1a2e;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.3);
  position: relative;
  transition: transform 0.3s;
}

.post-card-compact:active {
  transform: scale(0.98);
}

.post-card-compact.post-card-song_coming {
  border-left: 4rpx solid #533483;
}

.post-card-compact.post-card-song_released {
  border-left: 4rpx solid #00d4aa;
}

.post-card-compact.post-card-show {
  border-left: 4rpx solid #0f3460;
}

.post-compact-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.post-type-badge-compact {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.post-type-badge-compact.post-type-song_coming {
  background-color: rgba(83, 52, 131, 0.3);
  color: #533483;
}

.post-type-badge-compact.post-type-song_released {
  background-color: rgba(0, 212, 170, 0.3);
  color: #00d4aa;
}

.post-type-badge-compact.post-type-show {
  background-color: rgba(15, 52, 96, 0.3);
  color: #0f3460;
}

.post-time-compact {
  font-size: 20rpx;
  color: #8b8b8b;
}

.post-compact-image {
  width: 100%;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, #16213e 0%, #1a1a2e 100%);
}

.compact-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.post-compact-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #eaeaea;
  margin-bottom: 8rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-compact-content {
  font-size: 24rpx;
  color: rgba(234, 234, 234, 0.8);
  line-height: 1.5;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-compact-song {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
  background: rgba(15, 52, 96, 0.2);
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.song-icon {
  font-size: 20rpx;
}

.song-name-compact {
  font-size: 22rpx;
  color: #0f3460;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.post-compact-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.info-text-compact {
  font-size: 22rpx;
  color: #8b8b8b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-compact-date {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
  background: rgba(83, 52, 131, 0.2);
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.date-label {
  font-size: 22rpx;
  color: #8b8b8b;
}

.date-value {
  font-size: 22rpx;
  color: #533483;
  font-weight: 500;
}

.post-compact-actions {
  display: flex;
  justify-content: flex-end;
  gap: 15rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1px solid rgba(15, 52, 96, 0.3);
}

.action-icon-compact {
  font-size: 28rpx;
  padding: 5rpx;
  opacity: 0.7;
}

.action-icon-compact.delete {
  opacity: 0.6;
}

.empty-column {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #8b8b8b;
}

.empty-text-compact {
  font-size: 24rpx;
  color: #8b8b8b;
}


.showcase-empty {
  text-align: center;
  padding: 200rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #eaeaea;
  margin-bottom: 15rpx;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #8b8b8b;
  display: block;
}

.fab-showcase {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(15, 52, 96, 0.5);
  z-index: 100;
  transition: transform 0.3s;
}

.fab-showcase:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 50rpx;
  color: #ffffff;
}

