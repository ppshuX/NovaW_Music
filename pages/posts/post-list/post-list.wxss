/* pages/posts/post-list/post-list.wxss */
.timeline-container {
  background: linear-gradient(180deg, #16213e 0%, #1a1a2e 100%);
  min-height: 100vh;
}

.app-header {
  padding: 50rpx 30rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(15, 52, 96, 0.3) 0%, rgba(83, 52, 131, 0.2) 100%);
  margin-bottom: 30rpx;
  border-bottom: 1px solid rgba(15, 52, 96, 0.3);
}

.app-title {
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.app-subtitle {
  font-size: 26rpx;
  color: rgba(234, 234, 234, 0.7);
}

.timeline {
  position: relative;
  padding: 40rpx 0 200rpx 80rpx;
}

.timeline-item {
  position: relative;
  margin-bottom: 50rpx;
}

.timeline-dot {
  position: absolute;
  left: -60rpx;
  top: 30rpx;
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  border-radius: 50%;
  border: 4rpx solid #16213e;
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: -50rpx;
  top: 50rpx;
  width: 2rpx;
  height: calc(100% + 20rpx);
  background: linear-gradient(180deg, #0f3460 0%, transparent 100%);
  z-index: 1;
}

.post-card {
  background-color: #1a1a2e;
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.4);
  overflow: hidden;
  position: relative;
  transition: transform 0.3s, box-shadow 0.3s;
}

.post-card:active {
  transform: scale(0.98);
}

.post-card-song_coming {
  border-left: 6rpx solid #533483;
}

.post-card-song_released {
  border-left: 6rpx solid #00d4aa;
}

.post-card-show {
  border-left: 6rpx solid #0f3460;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
}

.post-type-badge {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  backdrop-filter: blur(10rpx);
}

.post-type-song_coming {
  background-color: rgba(83, 52, 131, 0.3);
  color: #533483;
}

.post-type-song_released {
  background-color: rgba(0, 212, 170, 0.3);
  color: #00d4aa;
}

.post-type-show {
  background-color: rgba(15, 52, 96, 0.3);
  color: #0f3460;
}

.post-time {
  font-size: 24rpx;
  color: #8b8b8b;
}

.post-hero-image {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #16213e 0%, #1a1a2e 100%);
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.post-content {
  padding: 30rpx;
}

.post-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #eaeaea;
  line-height: 1.4;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: rgba(234, 234, 234, 0.9);
  margin-bottom: 25rpx;
}

.post-song-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(15, 52, 96, 0.3) 0%, rgba(83, 52, 131, 0.2) 100%);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(15, 52, 96, 0.5);
}

.song-card-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.song-card-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.song-card-label {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-bottom: 5rpx;
}

.song-card-name {
  font-size: 30rpx;
  color: #0f3460;
  font-weight: bold;
}

.post-info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: rgba(22, 33, 62, 0.6);
  border-radius: 20rpx;
}

.info-icon {
  font-size: 28rpx;
}

.info-text {
  font-size: 26rpx;
  color: #8b8b8b;
}

.post-images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 0 30rpx 30rpx;
}

.grid-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.post-actions-float {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.post-card:active .post-actions-float {
  opacity: 1;
}

.action-menu {
  display: flex;
  gap: 15rpx;
  background: rgba(26, 26, 46, 0.9);
  backdrop-filter: blur(10rpx);
  padding: 10rpx 15rpx;
  border-radius: 20rpx;
}

.action-icon {
  font-size: 32rpx;
  padding: 5rpx;
}

.action-icon.delete {
  filter: grayscale(0.3);
}

.showcase-empty {
  text-align: center;
  padding: 200rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #eaeaea;
  margin-bottom: 15rpx;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #8b8b8b;
  display: block;
}

.fab-showcase {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(15, 52, 96, 0.5);
  z-index: 100;
  transition: transform 0.3s;
}

.fab-showcase:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 50rpx;
  color: #ffffff;
}

