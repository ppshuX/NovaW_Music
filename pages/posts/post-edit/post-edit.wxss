/* pages/posts/post-edit/post-edit.wxss */
.edit-container {
  background: linear-gradient(180deg, #16213e 0%, #1a1a2e 100%);
  min-height: 100vh;
  padding-bottom: 100rpx;
}

.page-header {
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #eaeaea;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.form-card {
  background-color: #1a1a2e;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.4);
}

.form-section {
  margin-bottom: 40rpx;
}

.form-section:last-child {
  margin-bottom: 0;
}

.section-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #eaeaea;
}

.label-required {
  font-size: 30rpx;
  color: #ff6b6b;
  margin-left: 5rpx;
}

.label-hint {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-left: 10rpx;
  font-weight: normal;
}

/* 输入框增强样式 */
.input-wrapper {
  position: relative;
}

.input-enhanced {
  width: 100%;
  background-color: #16213e;
  border: 2rpx solid rgba(15, 52, 96, 0.5);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  color: #eaeaea;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
}

.input-enhanced:focus {
  border-color: #533483;
  background-color: rgba(22, 33, 62, 0.8);
}

.input-enhanced::placeholder {
  color: #8b8b8b;
}

/* 文本域增强样式 */
.textarea-wrapper {
  position: relative;
}

.textarea-enhanced {
  width: 100%;
  min-height: 200rpx;
  background-color: #16213e;
  border: 2rpx solid rgba(15, 52, 96, 0.5);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  color: #eaeaea;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.3s;
}

.textarea-enhanced:focus {
  border-color: #533483;
  background-color: rgba(22, 33, 62, 0.8);
}

.textarea-enhanced::placeholder {
  color: #8b8b8b;
}

.char-count {
  position: absolute;
  bottom: 15rpx;
  right: 20rpx;
  font-size: 24rpx;
  color: #8b8b8b;
}

/* Picker增强样式 */
.picker-wrapper {
  position: relative;
  background-color: #16213e;
  border: 2rpx solid rgba(15, 52, 96, 0.5);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  transition: all 0.3s;
}

.picker-enhanced {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-text {
  font-size: 30rpx;
  color: #eaeaea;
  flex: 1;
}

.picker-text:empty::before {
  content: '请选择';
  color: #8b8b8b;
}

.picker-arrow {
  font-size: 40rpx;
  color: #8b8b8b;
  margin-left: 20rpx;
}

/* 图片上传增强样式 */
.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.image-item-enhanced {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #16213e;
}

.preview-image-enhanced {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-image-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(255, 107, 107, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.delete-icon {
  font-size: 36rpx;
  color: #ffffff;
  line-height: 1;
  font-weight: bold;
}

.upload-image-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(15, 52, 96, 0.3) 0%, rgba(83, 52, 131, 0.2) 100%);
  border: 2rpx dashed rgba(15, 52, 96, 0.5);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.upload-image-btn:active {
  background: linear-gradient(135deg, rgba(15, 52, 96, 0.4) 0%, rgba(83, 52, 131, 0.3) 100%);
  border-color: #533483;
}

.upload-icon {
  font-size: 60rpx;
  color: #533483;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 发布按钮增强样式 */
.action-buttons-enhanced {
  padding: 0 30rpx;
  margin-top: 40rpx;
}

.btn-publish {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(15, 52, 96, 0.4);
  border: none;
  transition: all 0.3s;
}

.btn-publish:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(15, 52, 96, 0.3);
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

