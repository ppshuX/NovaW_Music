<!--pages/posts/post-edit/post-edit.wxml-->
<view class="container">
  <view class="card">
    <view class="form-item">
      <view class="form-label">动态类型 *</view>
      <picker 
        mode="selector" 
        range="{{typeOptions}}"
        range-key="label"
        value="{{typeOptions.findIndex(t => t.value === postType)}}"
        bindchange="onTypeChange"
      >
        <view class="picker">{{typeOptions.find(t => t.value === postType).label}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">标题 *</view>
      <input 
        class="input" 
        placeholder="输入动态标题"
        value="{{formData.title}}"
        bindinput="onTitleInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">内容</view>
      <textarea 
        class="textarea" 
        placeholder="描述一下..."
        value="{{formData.content}}"
        bindinput="onContentInput"
        maxlength="500"
      />
    </view>

    <!-- 歌曲选择（新歌相关） -->
    <view class="form-item" wx:if="{{postType === 'song_coming' || postType === 'song_released'}}">
      <view class="form-label">关联歌曲</view>
      <picker 
        mode="selector" 
        range="{{songs}}"
        range-key="title"
        value="{{songs.findIndex(s => s.song_id === formData.song_id)}}"
        bindchange="onSongChange"
      >
        <view class="picker">{{formData.song_title || '选择歌曲（可选）'}}</view>
      </picker>
    </view>

    <!-- 日期 -->
    <view class="form-item">
      <view class="form-label">日期</view>
      <picker 
        mode="date" 
        value="{{formData.date}}"
        bindchange="onDateChange"
      >
        <view class="picker">{{formData.date || '选择日期（可选）'}}</view>
      </picker>
    </view>

    <!-- 地点（演出信息） -->
    <view class="form-item" wx:if="{{postType === 'show'}}">
      <view class="form-label">演出地点</view>
      <input 
        class="input" 
        placeholder="如：XX酒吧、XX音乐节"
        value="{{formData.location}}"
        bindinput="onLocationInput"
      />
    </view>

    <!-- 图片 -->
    <view class="form-item">
      <view class="form-label">图片</view>
      <view class="images-list" wx:if="{{formData.images.length > 0}}">
        <view class="image-item" wx:for="{{formData.images}}" wx:key="*this" wx:for-index="imgIndex">
          <image class="preview-image" src="{{item}}" mode="aspectFill"></image>
          <text class="delete-image" bindtap="deleteImage" data-index="{{imgIndex}}">×</text>
        </view>
      </view>
      <button class="btn btn-secondary" size="mini" bindtap="uploadImage">+ 添加图片</button>
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn btn-primary" bindtap="save">{{isEdit ? '保存' : '发布'}}</button>
  </view>
</view>

