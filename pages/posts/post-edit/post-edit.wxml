<!--pages/posts/post-edit/post-edit.wxml-->
<view class="container edit-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-title">{{isEdit ? '编辑动态' : '发布动态'}}</view>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card">
    <!-- 动态类型 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text">动态类型</text>
        <text class="label-required">*</text>
        <text class="category-hint" wx:if="{{currentCategory}}">（{{currentCategory}}）</text>
      </view>
      <picker 
        mode="selector" 
        range="{{typeOptions}}"
        range-key="label"
        value="{{postTypeIndex}}"
        bindchange="onTypeChange"
      >
        <view class="picker-wrapper picker-enhanced">
          <view class="picker-content">
            <text class="picker-text">{{currentTypeLabel}}</text>
            <text class="picker-category" wx:if="{{currentCategory}}">{{currentCategory}}</text>
          </view>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 标题 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text">标题</text>
        <text class="label-required">*</text>
      </view>
      <view class="input-wrapper">
        <input 
          class="input-enhanced" 
          placeholder="输入动态标题..."
          value="{{formData.title}}"
          bindinput="onTitleInput"
          maxlength="100"
        />
      </view>
    </view>

    <!-- 内容 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text">内容</text>
        <text class="label-hint">（选填）</text>
      </view>
      <view class="textarea-wrapper">
        <textarea 
          class="textarea-enhanced" 
          placeholder="描述一下你的动态..."
          value="{{formData.content}}"
          bindinput="onContentInput"
          maxlength="500"
          auto-height
        />
        <view class="char-count">{{formData.content.length}}/500</view>
      </view>
    </view>

    <!-- 歌曲选择（新歌相关） -->
    <view class="form-section" wx:if="{{postType === 'song_coming' || postType === 'song_released'}}">
      <view class="section-label">
        <text class="label-text">关联歌曲</text>
        <text class="label-hint">（选填）</text>
      </view>
      <picker 
        mode="selector" 
        range="{{songs}}"
        range-key="title"
        value="{{selectedSongIndex}}"
        bindchange="onSongChange"
      >
        <view class="picker-wrapper picker-enhanced">
          <text class="picker-text">{{formData.song_title || '选择歌曲'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 日期 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text">日期</text>
        <text class="label-hint">（选填）</text>
      </view>
      <picker 
        mode="date" 
        value="{{formData.date}}"
        bindchange="onDateChange"
      >
        <view class="picker-wrapper picker-enhanced">
          <text class="picker-text">{{formData.date || '选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 地点（演出信息） -->
    <view class="form-section" wx:if="{{postType === 'show'}}">
      <view class="section-label">
        <text class="label-text">演出地点</text>
        <text class="label-hint">（选填）</text>
      </view>
      <view class="input-wrapper">
        <input 
          class="input-enhanced" 
          placeholder="如：XX酒吧、XX音乐节"
          value="{{formData.location}}"
          bindinput="onLocationInput"
          maxlength="50"
        />
      </view>
    </view>

    <!-- 图片 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text">图片</text>
        <text class="label-hint">（选填）</text>
      </view>
      <view class="images-grid" wx:if="{{formData.images.length > 0}}">
        <view class="image-item-enhanced" wx:for="{{formData.images}}" wx:key="*this" wx:for-index="imgIndex">
          <image class="preview-image-enhanced" src="{{item}}" mode="aspectFill"></image>
          <view class="delete-image-btn" bindtap="deleteImage" data-index="{{imgIndex}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
      </view>
      <view class="upload-image-btn" bindtap="uploadImage">
        <text class="upload-icon">+</text>
        <text class="upload-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="action-buttons-enhanced">
    <button class="btn-publish" bindtap="save">
      <text class="btn-text">{{isEdit ? '保存' : '发布'}}</text>
    </button>
  </view>
</view>

