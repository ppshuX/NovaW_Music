/* pages/practice/practice-log/practice-log.wxss */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.add-btn {
  font-size: 28rpx;
  color: #0f3460;
  padding: 8rpx 16rpx;
  background-color: rgba(15, 52, 96, 0.2);
  border-radius: 8rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  margin-bottom: 15rpx;
  color: #8b8b8b;
  font-weight: 500;
}

.picker-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  background-color: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 12rpx;
  min-height: 44rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #eaeaea;
  flex: 1;
}

.picker-arrow {
  font-size: 32rpx;
  color: #8b8b8b;
  margin-left: 15rpx;
}

.input-wrapper {
  position: relative;
}

.input {
  width: 100%;
  padding: 24rpx 20rpx;
  background-color: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 12rpx;
  color: #eaeaea;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input::placeholder {
  color: #8b8b8b;
}

.textarea-wrapper {
  position: relative;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 12rpx;
  color: #eaeaea;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea::placeholder {
  color: #8b8b8b;
}

.char-count {
  position: absolute;
  bottom: 10rpx;
  right: 15rpx;
  font-size: 24rpx;
  color: #8b8b8b;
}

.action-buttons {
  margin-top: 30rpx;
  padding-bottom: 40rpx;
}

.action-buttons .btn {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
}

.logs-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.log-card {
  padding: 30rpx;
  background: linear-gradient(135deg, #16213e 0%, #1a1a2e 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #0f3460;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid rgba(15, 52, 96, 0.3);
}

.log-song-info {
  flex: 1;
}

.log-song-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #eaeaea;
  margin-bottom: 8rpx;
}

.log-song-artist {
  font-size: 26rpx;
  color: #8b8b8b;
}

.log-date-badge {
  padding: 8rpx 16rpx;
  background-color: rgba(15, 52, 96, 0.3);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #0f3460;
  white-space: nowrap;
}

.log-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.log-duration-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  background-color: rgba(0, 212, 170, 0.2);
  border-radius: 20rpx;
  width: fit-content;
}

.duration-icon {
  font-size: 24rpx;
}

.duration-text {
  font-size: 26rpx;
  color: #00d4aa;
  font-weight: bold;
}

.log-notes {
  padding: 15rpx;
  background-color: rgba(15, 52, 96, 0.1);
  border-radius: 10rpx;
  line-height: 1.8;
}

.notes-label {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-right: 8rpx;
}

.notes-text {
  font-size: 26rpx;
  color: #eaeaea;
}

.empty-state {
  text-align: center;
  padding: 100rpx 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #8b8b8b;
  margin-bottom: 40rpx;
}

.empty-state .btn {
  width: 200rpx;
}

