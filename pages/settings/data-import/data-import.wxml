<!--pages/settings/data-import/data-import.wxml-->
<view class="container">
  <view class="card">
    <view class="section-title">批量导入歌曲</view>
    <view class="import-info">
      <text class="info-text">准备导入 {{songsCount}} 首歌曲</text>
      <text class="info-hint">已存在的歌曲将被自动跳过</text>
    </view>
    
    <view class="songs-preview" wx:if="{{songsToImport.length > 0}}">
      <view class="preview-title">歌曲列表预览：</view>
      <view class="song-preview-item" wx:for="{{songsToImport}}" wx:key="title">
        <text class="song-name">{{item.title}}</text>
        <text class="song-artist">{{item.artist}}</text>
        <text class="song-date">{{item.date}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{importResult}}">
    <view class="section-title">导入结果</view>
    <view class="result-info">
      <view class="result-item">
        <text class="result-label">成功导入：</text>
        <text class="result-value success">{{importResult.imported}} 首</text>
      </view>
      <view class="result-item" wx:if="{{importResult.skipped > 0}}">
        <text class="result-label">跳过：</text>
        <text class="result-value">{{importResult.skipped}} 首</text>
      </view>
      <view class="result-item">
        <text class="result-label">当前总数：</text>
        <text class="result-value">{{importResult.total}} 首</text>
      </view>
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn btn-secondary" bindtap="previewSongs">预览列表</button>
    <button class="btn btn-primary" bindtap="importData">开始导入</button>
  </view>
</view>

