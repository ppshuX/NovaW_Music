/* pages/settings/data-import/data-import.wxss */
.import-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 30rpx;
}

.info-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f3460;
}

.info-hint {
  font-size: 24rpx;
  color: #8b8b8b;
}

.songs-preview {
  margin-top: 30rpx;
}

.preview-title {
  font-size: 28rpx;
  color: #8b8b8b;
  margin-bottom: 20rpx;
}

.song-preview-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 15rpx;
  background-color: #16213e;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.song-name {
  font-size: 28rpx;
  font-weight: bold;
  flex: 1;
}

.song-artist {
  font-size: 24rpx;
  color: #8b8b8b;
  min-width: 120rpx;
}

.song-date {
  font-size: 24rpx;
  color: #0f3460;
}

.result-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  background-color: #16213e;
  border-radius: 10rpx;
}

.result-label {
  font-size: 28rpx;
  color: #8b8b8b;
}

.result-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f3460;
}

.result-value.success {
  color: #00d4aa;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-bottom: 40rpx;
}

.action-buttons .btn {
  flex: 1;
}

