<!--pages/songs/song-edit/song-edit.wxml-->
<view class="container">
  <view class="card">
    <view class="form-item">
      <view class="form-label">歌曲名 *</view>
      <view class="input-wrapper">
        <input 
          class="input" 
          placeholder="请输入歌曲名"
          value="{{formData.title}}"
          bindinput="onTitleInput"
          maxlength="50"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">艺术家 *</view>
      <view class="input-wrapper">
        <input 
          class="input" 
          placeholder="请输入艺术家"
          value="{{formData.artist}}"
          bindinput="onArtistInput"
          maxlength="50"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">调性</view>
      <view class="input-wrapper">
        <input 
          class="input" 
          placeholder="如：C、G、Am等"
          value="{{formData.key}}"
          bindinput="onKeyInput"
          maxlength="10"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">变调夹（品）</view>
      <view class="input-wrapper">
        <input 
          class="input" 
          type="digit"
          placeholder="0"
          value="{{formData.capo}}"
          bindinput="onCapoInput"
          maxlength="2"
        />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">状态</view>
      <picker 
        mode="selector" 
        range="{{statusOptions}}"
        value="{{statusIndex}}"
        bindchange="onStatusChange"
      >
        <view class="picker-wrapper">
          <text class="picker-text">{{formData.status}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">熟练度</view>
      <picker 
        mode="selector" 
        range="{{[1,2,3,4,5]}}"
        value="{{formData.proficiency - 1}}"
        bindchange="onProficiencyChange"
      >
        <view class="picker-wrapper">
          <text class="picker-text">{{formData.proficiency}}星</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">难度</view>
      <picker 
        mode="selector" 
        range="{{difficultyOptions}}"
        value="{{formData.difficulty - 1}}"
        bindchange="onDifficultyChange"
      >
        <view class="picker-wrapper">
          <text class="picker-text">{{formData.difficulty}}/5</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">标签</view>
      <view class="tag-input-group">
        <input 
          class="input tag-input" 
          placeholder="输入标签后点击添加"
          value="{{tagInput}}"
          bindinput="onTagInput"
        />
        <button class="btn btn-primary" size="mini" bindtap="addTag">添加</button>
      </view>
      <view class="tags-list" wx:if="{{formData.tags.length > 0}}">
        <text 
          class="tag" 
          wx:for="{{formData.tags}}" 
          wx:key="*this"
        >
          {{item}}
          <text class="tag-remove" bindtap="removeTag" data-index="{{index}}">×</text>
        </text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">段落掌握</view>
      <view class="sections-edit">
        <view 
          class="section-checkbox {{formData.sections.intro ? 'checked' : ''}}"
          bindtap="toggleSection"
          data-section="intro"
        >
          <text class="checkbox-icon">{{formData.sections.intro ? '✓' : '○'}}</text>
          <text>Intro</text>
        </view>
        <view 
          class="section-checkbox {{formData.sections.verse ? 'checked' : ''}}"
          bindtap="toggleSection"
          data-section="verse"
        >
          <text class="checkbox-icon">{{formData.sections.verse ? '✓' : '○'}}</text>
          <text>Verse</text>
        </view>
        <view 
          class="section-checkbox {{formData.sections.chorus ? 'checked' : ''}}"
          bindtap="toggleSection"
          data-section="chorus"
        >
          <text class="checkbox-icon">{{formData.sections.chorus ? '✓' : '○'}}</text>
          <text>Chorus</text>
        </view>
        <view 
          class="section-checkbox {{formData.sections.bridge ? 'checked' : ''}}"
          bindtap="toggleSection"
          data-section="bridge"
        >
          <text class="checkbox-icon">{{formData.sections.bridge ? '✓' : '○'}}</text>
          <text>Bridge</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">技术要点</view>
      <view class="tag-input-group">
        <input 
          class="input tag-input" 
          placeholder="如：气息、节奏、咬字等"
          value="{{techPointInput}}"
          bindinput="onTechPointInput"
        />
        <button class="btn btn-primary" size="mini" bindtap="addTechPoint">添加</button>
      </view>
      <view class="tags-list" wx:if="{{formData.technical_points.length > 0}}">
        <text 
          class="tag" 
          wx:for="{{formData.technical_points}}" 
          wx:key="*this"
        >
          {{item}}
          <text class="tag-remove" bindtap="removeTechPoint" data-index="{{index}}">×</text>
        </text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">预期发布日期</view>
      <picker 
        mode="date" 
        value="{{formData.expected_release_date}}"
        bindchange="onReleaseDateChange"
      >
        <view class="picker-wrapper">
          <text class="picker-text">{{formData.expected_release_date || '选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">备注</view>
      <view class="textarea-wrapper">
        <textarea 
          class="textarea" 
          placeholder="添加备注..."
          value="{{formData.notes}}"
          bindinput="onNotesInput"
          maxlength="500"
          auto-height
          show-confirm-bar="{{false}}"
        />
        <view class="char-count">{{formData.notes.length}}/500</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="form-label">私密设置</view>
      <switch 
        checked="{{formData.is_private}}"
        bindchange="togglePrivate"
        color="#0f3460"
      />
      <text class="form-hint">开启后，此歌曲不会在公开展示页显示</text>
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn btn-primary" bindtap="save">{{isEdit ? '保存' : '添加'}}</button>
  </view>
</view>

