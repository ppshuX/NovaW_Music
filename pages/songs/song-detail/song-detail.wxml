<!--pages/songs/song-detail/song-detail.wxml-->
<view class="container" wx:if="{{song}}">
  <!-- 歌曲基本信息 -->
  <view class="card">
    <view class="song-header">
      <view class="song-title-section">
        <view class="song-title">{{song.title}}</view>
        <view class="song-artist">{{song.artist}}</view>
      </view>
      <view class="song-status-badge" style="background-color: {{song.status === '未开始' ? '#8b8b8b' : song.status === '练习中' ? '#0f3460' : song.status === '可录制' ? '#533483' : '#00d4aa'}}">
        {{song.status}}
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-section">
      <view class="progress-label">整体进度</view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{song.progress_percentage}}%"></view>
      </view>
      <text class="progress-text">{{song.progress_percentage}}%</text>
    </view>

    <!-- 熟练度 -->
    <view class="proficiency-section">
      <view class="section-label">熟练度</view>
      <view class="stars {{readonly ? 'readonly' : ''}}">
        <text 
          class="star {{index <= song.proficiency ? '' : 'empty'}}" 
          wx:for="{{[1,2,3,4,5]}}" 
          wx:key="*this" 
          wx:for-item="index"
          bindtap="changeProficiency"
          data-rating="{{index}}"
        >★</text>
      </view>
    </view>
  </view>

  <!-- 歌曲信息 -->
  <view class="card">
    <view class="section-title">歌曲信息</view>
    <view class="info-grid">
      <view class="info-item" wx:if="{{song.key}}">
        <text class="info-label">调性：</text>
        <text class="info-value">{{song.key}}</text>
      </view>
      <view class="info-item" wx:if="{{song.capo > 0}}">
        <text class="info-label">变调夹：</text>
        <text class="info-value">{{song.capo}}品</text>
      </view>
      <view class="info-item">
        <text class="info-label">难度：</text>
        <text class="info-value">{{song.difficulty}}/5</text>
      </view>
    </view>

    <view class="tags-section" wx:if="{{song.tags && song.tags.length > 0}}">
      <text class="tag" wx:for="{{song.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 段落掌握情况 -->
  <view class="card">
    <view class="section-title">段落掌握</view>
    <view class="sections-grid">
      <view 
        class="section-item {{song.sections.intro ? 'mastered' : ''}} {{readonly ? 'readonly' : ''}}"
        bindtap="toggleSection"
        data-section="intro"
      >
        <text class="section-name">Intro</text>
        <text class="section-status">{{song.sections.intro ? '✓' : '○'}}</text>
      </view>
      <view 
        class="section-item {{song.sections.verse ? 'mastered' : ''}} {{readonly ? 'readonly' : ''}}"
        bindtap="toggleSection"
        data-section="verse"
      >
        <text class="section-name">Verse</text>
        <text class="section-status">{{song.sections.verse ? '✓' : '○'}}</text>
      </view>
      <view 
        class="section-item {{song.sections.chorus ? 'mastered' : ''}} {{readonly ? 'readonly' : ''}}"
        bindtap="toggleSection"
        data-section="chorus"
      >
        <text class="section-name">Chorus</text>
        <text class="section-status">{{song.sections.chorus ? '✓' : '○'}}</text>
      </view>
      <view 
        class="section-item {{song.sections.bridge ? 'mastered' : ''}} {{readonly ? 'readonly' : ''}}"
        bindtap="toggleSection"
        data-section="bridge"
      >
        <text class="section-name">Bridge</text>
        <text class="section-status">{{song.sections.bridge ? '✓' : '○'}}</text>
      </view>
    </view>
  </view>

  <!-- 技术要点 -->
  <view class="card" wx:if="{{song.technical_points && song.technical_points.length > 0}}">
    <view class="section-title">技术要点</view>
    <view class="technical-points">
      <text class="tech-point" wx:for="{{song.technical_points}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 状态切换 -->
  <view class="card">
    <view class="section-title">状态</view>
    <view class="status-buttons">
      <button 
        class="status-btn {{song.status === '未开始' ? 'active' : ''}} {{readonly ? 'readonly' : ''}}"
        data-status="未开始"
        bindtap="changeStatus"
        size="mini"
        disabled="{{readonly}}"
      >未开始</button>
      <button 
        class="status-btn {{song.status === '练习中' ? 'active' : ''}} {{readonly ? 'readonly' : ''}}"
        data-status="练习中"
        bindtap="changeStatus"
        size="mini"
        disabled="{{readonly}}"
      >练习中</button>
      <button 
        class="status-btn {{song.status === '可录制' ? 'active' : ''}} {{readonly ? 'readonly' : ''}}"
        data-status="可录制"
        bindtap="changeStatus"
        size="mini"
        disabled="{{readonly}}"
      >可录制</button>
      <button 
        class="status-btn {{song.status === '已完成' ? 'active' : ''}} {{readonly ? 'readonly' : ''}}"
        data-status="已完成"
        bindtap="changeStatus"
        size="mini"
        disabled="{{readonly}}"
      >已完成</button>
    </view>
  </view>

  <!-- 演示视频 -->
  <view class="card">
    <view class="section-title">
      <text>演示视频</text>
      <button class="btn-icon" size="mini" bindtap="uploadVideo" wx:if="{{!readonly}}">+ 上传</button>
    </view>
    <view class="media-list" wx:if="{{song.demo_videos && song.demo_videos.length > 0}}">
      <view class="media-item video-item" wx:for="{{song.demo_videos}}" wx:key="url" wx:for-index="videoIndex">
        <view class="media-preview" bindtap="playVideo" data-url="{{item.url}}">
          <view class="video-placeholder">
            <text class="video-icon">🎬</text>
          </view>
          <view class="play-icon">▶</view>
        </view>
        <view class="media-info">
          <view class="media-name">{{item.name}}</view>
          <view class="media-meta">
            <text class="media-date">{{item.date}}</text>
            <text class="media-duration" wx:if="{{item.duration}}">{{item.duration}}秒</text>
          </view>
        </view>
        <view class="media-actions" wx:if="{{!readonly}}">
          <text class="delete-btn" bindtap="deleteVideo" data-index="{{videoIndex}}">删除</text>
        </view>
      </view>
    </view>
    <view class="empty-media" wx:else>
      <text>还没有演示视频</text>
    </view>
  </view>

  <!-- 乐谱 -->
  <view class="card">
    <view class="section-title">
      <text>乐谱</text>
      <button class="btn-icon" size="mini" bindtap="uploadSheetMusic" wx:if="{{!readonly}}">+ 上传</button>
    </view>
    <view class="media-list" wx:if="{{song.sheet_music && song.sheet_music.length > 0}}">
      <view class="media-item sheet-item" wx:for="{{song.sheet_music}}" wx:key="url" wx:for-index="sheetIndex">
        <view class="sheet-preview" bindtap="previewSheetMusic" data-index="{{sheetIndex}}">
          <image class="sheet-thumbnail" src="{{item.url}}" mode="aspectFill"></image>
        </view>
        <view class="media-info">
          <view class="media-name">{{item.name}}</view>
          <view class="media-meta">
            <text class="media-date">{{item.date}}</text>
          </view>
        </view>
        <view class="media-actions" wx:if="{{!readonly}}">
          <text class="delete-btn" bindtap="deleteSheetMusic" data-index="{{sheetIndex}}">删除</text>
        </view>
      </view>
    </view>
    <view class="empty-media" wx:else>
      <text>还没有乐谱</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card" wx:if="{{song.notes}}">
    <view class="section-title">备注</view>
    <view class="notes-content">{{song.notes}}</view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons" wx:if="{{!readonly}}">
    <button class="btn btn-secondary" bindtap="editSong">编辑歌曲</button>
  </view>
  
  <!-- 编辑提示 -->
  <view class="edit-hint" wx:if="{{!readonly}}">
    <text class="hint-icon">💡</text>
    <text class="hint-text">点击段落、星级、状态即可实时保存</text>
  </view>
  
  <!-- 只读模式提示 -->
  <view class="readonly-notice" wx:if="{{readonly}}">
    <text class="notice-icon">👁</text>
    <text class="notice-text">只读模式 - 仅可查看，无法修改</text>
  </view>
</view>

