/* pages/songs/song-list/song-list.wxss */
.search-bar {
  margin-bottom: 30rpx;
}

.search-input {
  width: 100%;
  padding: 20rpx;
  background-color: #1a1a2e;
  border: 1px solid #0f3460;
  border-radius: 10rpx;
  color: #eaeaea;
  font-size: 28rpx;
}

.filter-tabs {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-tab {
  padding: 12rpx 24rpx;
  background-color: #1a1a2e;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #8b8b8b;
  white-space: nowrap;
}

.filter-tab.active {
  background-color: #0f3460;
  color: #ffffff;
}

.song-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-bottom: 120rpx;
}

.song-card {
  background-color: #1a1a2e;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.song-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.song-main-info {
  flex: 1;
}

.song-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.song-artist {
  font-size: 26rpx;
  color: #8b8b8b;
}

.song-status {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.song-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #16213e;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #8b8b8b;
}

.meta-value {
  font-size: 24rpx;
  color: #eaeaea;
}

.song-progress-section {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #8b8b8b;
  min-width: 80rpx;
}

.song-tags {
  margin-bottom: 20rpx;
}

.song-actions {
  display: flex;
  gap: 15rpx;
  justify-content: flex-end;
}

.action-btn {
  background-color: #16213e;
  color: #eaeaea;
  border: 1px solid #0f3460;
}

.delete-btn {
  color: #ff6b6b;
  border-color: #ff6b6b;
}

.empty-state {
  text-align: center;
  padding: 100rpx 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b8b8b;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #0f3460 0%, #533483 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(15, 52, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: 300;
}

