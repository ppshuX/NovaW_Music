/**app.wxss**/
page {
  background-color: #16213e;
  color: #eaeaea;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* 通用按钮样式 */
.btn {
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 28rpx;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
  color: #ffffff;
}

.btn-secondary {
  background-color: #1a1a2e;
  color: #eaeaea;
  border: 1px solid #0f3460;
}

/* 卡片样式 */
.card {
  background-color: #1a1a2e;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 输入框样式 */
.input {
  width: 100%;
  background-color: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  color: #eaeaea;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #533483;
}

.input::placeholder {
  color: #8b8b8b;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: #0f3460;
  color: #eaeaea;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

/* 进度条样式 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #16213e;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0f3460 0%, #533483 100%);
  transition: width 0.3s;
}

/* 星级评分 */
.stars {
  display: flex;
  gap: 10rpx;
}

.star {
  width: 40rpx;
  height: 40rpx;
  color: #ffd700;
}

.star.empty {
  color: #8b8b8b;
}

